# Conexion a la base de datos
# PostgreSQL: postgresql://usuario:password@localhost:5432/foodstore_db
# Para desarrollo local se puede usar SQLite (no hace falta instalar nada):
DATABASE_URL=sqlite:///./foodstore.db

# Clave para firmar el JWT (minimo 32 caracteres, cambiarla en produccion)
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

# Algoritmo del JWT
ALGORITHM=HS256

# Minutos que dura el token y la cookie
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (se pueden poner varios separados por coma)
FRONTEND_ORIGIN=http://localhost:5173
